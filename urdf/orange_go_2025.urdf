<?xml version="1.0"?>
<robot name="orange_go_2025">

  <link name="base_link"/>
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.064" rpy="0 0 0"/> </joint>

  <link name="left_wheel">
    </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.177 0" rpy="-1.57079632679 0 0"/> 
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel"/>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.177 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <ros2_control name="Zlac8015dSystem" type="system">
    <hardware>
      <plugin>zlac8015d_hardware/Zlac8015dSystemHardware</plugin>

      <!-- CANopen -->
      <param name="can_interface">can0</param>
      <param name="node_id">1</param>

      <!--
        Keep "velocity" until b0 identification is finished.
        Then set this to "ladrc_torque" and replace ladrc_b0_left/right
        with the values reported by analyze_b0.py.
      -->
      <param name="control_mode">ladrc_torque</param>

      <!-- Identified wheel nominal gains; torque/current modes keep this plant input. -->
      <param name="ladrc_b0_left">18.0</param>
      <param name="ladrc_b0_right">18.0</param>
      <param name="ladrc_wc">5.0</param>
      <param name="ladrc_wo">20.0</param>

      <!-- Legacy PID baseline, inherited by MIMO PID unless overridden. -->
      <param name="pid_kp">0.7</param>
      <param name="pid_ki">0.5</param>
      <param name="pid_kd">0.03</param>
      <param name="pid_derivative_filter_tau_s">0.05</param>

      <!-- MIMO modes: mimo_ladrc_torque / mimo_pid_torque.
           Initial gains reproduce the legacy wheel controller under
           symmetric b0 and identical v/yaw bandwidth. Tune yaw independently. -->
      <param name="mimo_wheel_radius">0.064</param>
      <param name="mimo_wheel_separation">0.354</param>
      <param name="mimo_wc_v">5.0</param>
      <param name="mimo_wc_omega">5.0</param>
      <param name="mimo_wo_v">20.0</param>
      <param name="mimo_wo_omega">20.0</param>
      <param name="mimo_pid_kp_v">0.7</param>
      <param name="mimo_pid_kp_omega">0.7</param>
      <param name="mimo_pid_ki_v">0.5</param>
      <param name="mimo_pid_ki_omega">0.5</param>
      <param name="mimo_pid_kd_v">0.03</param>
      <param name="mimo_pid_kd_omega">0.03</param>

      <!-- Current-command safety constraints -->
      <param name="current_limit_a">8.0</param>
      <param name="current_rate_limit_a_per_s">20.0</param>
      <param name="feedback_timeout_ms">30.0</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
